{
  "servers": [
    {
      "name": "runbooks",
      "enabled": false,
      "transport": "http",
      "url": "https://mcp.example.com/mcp",
      "headers_from_env": {"Authorization": "MCP_RUNBOOK_AUTH"},
      "tools": {
        "search_runbooks": {
          "domains": ["changes"],
