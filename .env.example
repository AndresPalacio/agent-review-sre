# Proveedor LLM y modelos por rol. Deja vacío un LLM_MODEL_* para usar el default del proveedor.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_REASONING=
LLM_MODEL_WORKER=
LLM_MODEL_FAST=
LLM_MODEL_JUDGE=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Modelos de respaldo `proveedor:modelo`, separados por comas; vacío = sin fallback.
LLM_FALLBACK_MODELS=

# Persistencia: memory | sqlite | postgres
PERSISTENCE_BACKEND=memory
SQLITE_PATH=data/sre-graph.sqlite
# Postgres de docker compose; connect_timeout evita esperas largas si no responde.
DATABASE_URL=postgresql://sre_graph:sre_graph@localhost:5433/sre_graph?connect_timeout=5
# Opcional: openai activa búsqueda semántica pgvector (text-embedding-3-small); vacío = búsqueda léxica.
EMBEDDINGS_PROVIDER=

# Entorno. AUTO_APPROVE_TOOLS solo aplica en dev, development, local, test o staging;
# cualquier otro nombre (prod, production...) cuenta como producción y todo cambio pide aprobación.
ENVIRONMENT=dev
# Tools que cambian estado y corren sin aprobación en un entorno no productivo, separadas por comas.
AUTO_APPROVE_TOOLS=
# IDs de aprobadores permitidos (opcional, separados por comas). API: SHA-256 hexadecimal
# de cada API key de rol approver/admin; CLI local: local:<usuario>.
APPROVER_IDS=
# Enmascarar identificadores (pods, namespaces, IPs, emails...) antes de enviarlos al modelo.
MASK_ENABLED=false
# Tipos a enmascarar; vacío = todos: pod,namespace,cluster,hostname,account_id,ip_address,email,service_name
MASK_KINDS=
# Patrones extra en JSON, por ejemplo {"ticket": "TCK-[0-9]+"}
MASK_EXTRA_REGEX=
# Clave de los tokens de masking (HMAC); vacía = una aleatoria por proceso, y los tokens
# cambian al reiniciar. Fíjala si necesitas tokens estables entre procesos.
MASK_KEY=

# Kubernetes; las operaciones de cambio solo se ejecutan tras aprobación HITL.
# Apagado hasta K8S_ENABLED=true.
K8S_ENABLED=false
# Vacío = KUBECONFIG o ~/.kube/config; K8S_CONTEXT vacío = el contexto actual del archivo.
K8S_KUBECONFIG=
K8S_CONTEXT=
K8S_IN_CLUSTER=false
K8S_VERIFY_NAMESPACE=default
K8S_REQUEST_TIMEOUT_SECONDS=30
K8S_MAX_ITEMS=200

# Endpoints de métricas y alertas, activados de forma independiente.
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=
PROMETHEUS_TOKEN=
PROMETHEUS_REQUEST_TIMEOUT_SECONDS=15
ALERTMANAGER_ENABLED=false
ALERTMANAGER_URL=
ALERTMANAGER_TOKEN=
ALERTMANAGER_REQUEST_TIMEOUT_SECONDS=15
# URL habitual de Mimir: https://mimir.example/prometheus
MIMIR_ENABLED=false
MIMIR_URL=
MIMIR_TOKEN=
MIMIR_TENANT=
MIMIR_REQUEST_TIMEOUT_SECONDS=15

# Grafana y sus almacenes nativos: cada endpoint se activa por separado.
GRAFANA_ENABLED=false
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_REQUEST_TIMEOUT_SECONDS=15
LOKI_ENABLED=false
LOKI_URL=
LOKI_TOKEN=
LOKI_TENANT=
LOKI_REQUEST_TIMEOUT_SECONDS=15
TEMPO_ENABLED=false
TEMPO_URL=
TEMPO_TOKEN=
TEMPO_TENANT=
TEMPO_REQUEST_TIMEOUT_SECONDS=15

# Datadog: DATADOG_SITE es el dominio del sitio, por ejemplo datadoghq.eu.
DATADOG_ENABLED=false
DATADOG_SITE=datadoghq.com
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_REQUEST_TIMEOUT_SECONDS=15

# New Relic NerdGraph (requiere user key y account id).
NEWRELIC_ENABLED=false
NEWRELIC_REGION=us
NEWRELIC_API_KEY=
NEWRELIC_ACCOUNT_ID=
NEWRELIC_REQUEST_TIMEOUT_SECONDS=15

# AWS: credenciales por cadena estándar boto3; ninguna clave en este archivo.
AWS_ENABLED=false
AWS_REGION=
AWS_PROFILE=
AWS_REQUEST_TIMEOUT_SECONDS=15

# Sentry: token de solo lectura con event:read y project:read/release.
SENTRY_ENABLED=false
SENTRY_URL=https://sentry.io
SENTRY_ORGANIZATION=
SENTRY_TOKEN=
SENTRY_REQUEST_TIMEOUT_SECONDS=15

# GitHub: repo objetivo y token de solo lectura (contents, pull requests,
# actions y deployments según las consultas habilitadas).
GITHUB_ENABLED=false
GITHUB_URL=https://api.github.com
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_SECONDS=15

# Entrega de reportes; solo se envía cuando se llama DeliveryService.send_report.
SLACK_DELIVERY_ENABLED=false
SLACK_DELIVERY_TOKEN=
SLACK_DELIVERY_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_DELIVERY_TOKEN=
TELEGRAM_DELIVERY_REQUEST_TIMEOUT_SECONDS=15
PAGERDUTY_DELIVERY_ENABLED=false
PAGERDUTY_DELIVERY_TOKEN=
PAGERDUTY_DELIVERY_FROM_EMAIL=
PAGERDUTY_DELIVERY_REQUEST_TIMEOUT_SECONDS=15

# MCP: copia mcp-servers.example.json a mcp-servers.json y configura los nombres
# de variables allí. Servidor, Studio y CLI descubren los servidores habilitados.
# Vacío = mcp-servers.json si existe; las tools necesitan declaración de solo lectura.
MCP_CONFIG=
# MCP_RUNBOOK_AUTH=Bearer <token de solo lectura>

# API (fase 4): requiere Postgres y una clave admin aleatoria de 32+ caracteres.
# Genera la clave fuera del repositorio y mantenla privada. El servidor la guarda
# solo como hash. La API queda cerrada si falta.
BOOTSTRAP_ADMIN_KEY=
MAX_CONCURRENT_RUNS=4
# El pool advisory separado reserva hasta MAX_CONCURRENT_RUNS + 8 conexiones;
# dimensiona Postgres sumando ledger, checkpoints, Store, listener y scheduler.
# Límites por réplica: ejecuciones aceptadas (activas + en cola), HTTP y SSE.
MAX_PENDING_RUNS=128
MAX_HTTP_REQUESTS=128
MAX_STREAMS=64
SCHEDULER_ELECTION_SECONDS=3
STREAM_FALLBACK_SECONDS=15
THREAD_RETENTION_DAYS=30
APPROVAL_TTL_HOURS=24
ALERT_DEDUPE_MINUTES=30
# Rutas de reportes para webhooks: default o critical/high/warning/info.
# Una ruta de severidad sustituye default; {} en esa severidad desactiva su envio.
# Ejemplo: {"default":{"slack":"C123"},"critical":{"telegram":"42"}}
ALERT_DELIVERY_ROUTES={}
CORS_ORIGINS=

# Fase 6: gateways de entrada, independientes de SLACK_DELIVERY_/TELEGRAM_DELIVERY_.
# Apagados por defecto. Slack HTTP verifica firma Bolt; Socket Mode es optativo en dev.
SLACK_GATEWAY_ENABLED=false
SLACK_GATEWAY_BOT_TOKEN=
SLACK_GATEWAY_SIGNING_SECRET=
SLACK_GATEWAY_CHANNEL_ID=
SLACK_GATEWAY_APPROVER_USER_IDS=
SLACK_GATEWAY_SOCKET_MODE=false
SLACK_GATEWAY_APP_TOKEN=
TELEGRAM_GATEWAY_ENABLED=false
TELEGRAM_GATEWAY_BOT_TOKEN=
TELEGRAM_GATEWAY_WEBHOOK_SECRET=
TELEGRAM_GATEWAY_CHAT_ID=
TELEGRAM_GATEWAY_APPROVER_USER_IDS=

# Cada fuente requiere un token propio en X-Sre-Webhook-Token o un secreto HMAC
# en X-Sre-Signature: sha256=<hex>. Si hay HMAC configurado, el token no sirve.
# Formato JSON: {"alertmanager":"...","grafana":"...","datadog":"...",
# "cloudwatch":"...","sentry":"...","pagerduty":"...","newrelic":"...",
# "generic":"..."}. Un proxy puede inyectar el header si el vendor no lo soporta.
WEBHOOK_TOKENS={}
WEBHOOK_HMAC_SECRETS={}

# CloudWatch vía SNS: TopicArn y clave pública del certificado fijada por el
# operador; SigningCertURL del mensaje debe coincidir exactamente. No se descarga.
SNS_TOPIC_ARN=
SNS_CERT_URL=
SNS_PUBLIC_KEY_PATH=

# Sin trazas a terceros: apaga los tres interruptores (LANGCHAIN_TRACING_V2 tiene prioridad).
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING_V2=false

# Segunda ola: solo lecturas, todas deshabilitadas inicialmente.
# URL base sin credenciales/query; timeout común <PREFIJO>_REQUEST_TIMEOUT_SECONDS=15.
OPSGENIE_ENABLED=false
OPSGENIE_URL=https://api.opsgenie.com
OPSGENIE_TOKEN=
INCIDENT_IO_ENABLED=false
INCIDENT_IO_URL=https://api.incident.io
INCIDENT_IO_TOKEN=
JIRA_ENABLED=false
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
HONEYCOMB_ENABLED=false
HONEYCOMB_URL=https://api.honeycomb.io
HONEYCOMB_TOKEN=
HONEYCOMB_DATASET=
HONEYCOMB_POLL_ATTEMPTS=5
HONEYCOMB_POLL_INTERVAL_SECONDS=0.5
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=
ELASTICSEARCH_TOKEN=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=
OPENSEARCH_INDEX=
OPENSEARCH_TOKEN=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
SPLUNK_ENABLED=false
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_INDEX=
SPLUNK_API_VERSION=v2
VICTORIA_LOGS_ENABLED=false
VICTORIA_LOGS_URL=
VICTORIA_LOGS_TOKEN=
VICTORIA_LOGS_ACCOUNT_ID=0
VICTORIA_LOGS_PROJECT_ID=0
CORALOGIX_ENABLED=false
CORALOGIX_URL=
CORALOGIX_TOKEN=
AZURE_ENABLED=false
AZURE_URL=https://api.loganalytics.azure.com
# Bearer de Log Analytics; renovación a cargo del operador (no Managed Identity).
AZURE_TOKEN=
AZURE_WORKSPACE_ID=
AZURE_TABLE=AppTraces
ARGOCD_ENABLED=false
ARGOCD_URL=
ARGOCD_TOKEN=
ARGOCD_PROJECT=
ARGOCD_NAMESPACE=
HELM_ENABLED=false
HELM_EXECUTABLE=helm
HELM_NAMESPACE=default
HELM_CONTEXT=
HELM_KUBECONFIG=
GITLAB_ENABLED=false
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT=
