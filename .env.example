# Perfil local seguro por defecto: Ollama + SQLite + paper trading.
LLM_PROVIDER=ollama
LLM_MODEL_REASONING=
LLM_MODEL_WORKER=
LLM_MODEL_FAST=
LLM_MODEL_JUDGE=
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=1024
OLLAMA_BASE_URL=http://localhost:11434

# Claves opcionales de proveedores. Configura solo el proveedor seleccionado.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GIGACHAT_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Persistencia: sqlite para la app local, postgres para el servidor distribuido.
PERSISTENCE_BACKEND=sqlite
SQLITE_PATH=data/fin-graph.sqlite
DATABASE_URL=
EMBEDDINGS_PROVIDER=

# Cartera y análisis financiero.
BASE_CURRENCY=USD
INITIAL_CASH=100000
MARGIN_REQUIREMENT=0.5
RISK_FREE_RATE=0.045
MARKET_DATA_PROVIDER=yahoo
MARKET_FIXTURES_DIR=
FIN_ANALYST_MODE=auto

# Datos de mercado.
YAHOO_ENABLED=true
YAHOO_REQUEST_TIMEOUT_SECONDS=15
YAHOO_REPORT_LAG_DAYS=45
YAHOO_SNAPSHOT_MAX_AGE_DAYS=7
FINANCIAL_DATASETS_ENABLED=false
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATASETS_URL=https://api.financialdatasets.ai
FINANCIAL_DATASETS_REQUEST_TIMEOUT_SECONDS=15

# Límites deterministas; el modelo no puede omitirlos.
TRADING_MAX_ORDER_NOTIONAL=10000
TRADING_MAX_POSITION_PCT=0.25
TRADING_MAX_DAILY_ORDERS=10
TRADING_SHORT_SELLING_ENABLED=false
TRADING_ALLOWED_ACTIONS=
TRADING_KILL_SWITCH=false
PAPER_LEDGER_PATH=
PAPER_ACCOUNT_ID=paper
PAPER_MAX_PRICE_DRIFT=0.05
PAPER_SLIPPAGE_BPS=5

# Aprobaciones y protección de datos.
ENVIRONMENT=dev
AUTO_APPROVE_TOOLS=
APPROVER_IDS=
MASK_ENABLED=false
MASK_KINDS=
MASK_EXTRA_REGEX={}
MASK_KEY=

# Compatibilidad local con AI Hedge Fund. No habilitar públicamente sin un proxy autenticado.
FIN_GRAPH_LOCAL=true
FIN_GRAPH_LEGACY_API=true
FIN_GRAPH_ALLOW_INSECURE_LEGACY_API=true
FIN_GRAPH_TRUSTED_PROXIES=
FIN_GRAPH_DATA_DIR=data
FIN_GRAPH_HOST=127.0.0.1
FIN_GRAPH_COMPATIBILITY_KEY=
FIN_GRAPH_QUANT_ARTIFACT_DIR=.v2_cache/models
FIN_GRAPH_BACKTEST_ARTIFACT_DIR=.v2_cache/backtests

# API nativa distribuida.
BOOTSTRAP_ADMIN_KEY=
MAX_CONCURRENT_RUNS=4
MAX_PENDING_RUNS=128
MAX_HTTP_REQUESTS=128
MAX_STREAMS=64
SCHEDULER_ELECTION_SECONDS=3
STREAM_FALLBACK_SECONDS=15
THREAD_RETENTION_DAYS=30
APPROVAL_TTL_HOURS=24
SIGNAL_DEDUPE_MINUTES=30
SIGNAL_DELIVERY_ROUTES={}
CORS_ORIGINS=
WEBHOOK_TOKENS={}
WEBHOOK_HMAC_SECRETS={}

# Entrega financiera y gateways de entrada, deshabilitados por defecto.
SLACK_DELIVERY_ENABLED=false
SLACK_DELIVERY_TOKEN=
SLACK_DELIVERY_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_DELIVERY_TOKEN=
TELEGRAM_DELIVERY_REQUEST_TIMEOUT_SECONDS=15
SLACK_GATEWAY_ENABLED=false
SLACK_GATEWAY_BOT_TOKEN=
SLACK_GATEWAY_SIGNING_SECRET=
SLACK_GATEWAY_APP_TOKEN=
SLACK_GATEWAY_SOCKET_MODE=false
SLACK_GATEWAY_CHANNEL_ID=
SLACK_GATEWAY_APPROVER_USER_IDS=
SLACK_GATEWAY_MAX_BODY_BYTES=1048576
TELEGRAM_GATEWAY_ENABLED=false
TELEGRAM_GATEWAY_BOT_TOKEN=
TELEGRAM_GATEWAY_WEBHOOK_SECRET=
TELEGRAM_GATEWAY_CHAT_ID=
TELEGRAM_GATEWAY_APPROVER_USER_IDS=
TELEGRAM_GATEWAY_MAX_BODY_BYTES=1048576

# MCP: archivo de servidores y tools con metadatos financieros explícitos.
MCP_CONFIG=

# No enviar trazas a terceros por defecto.
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING_V2=false

# Presupuesto y huella del harness financiero.
FIN_ANALYSIS_MAX_WAVES=2
FIN_ANALYSIS_MAX_TASKS_PER_WAVE=6
FIN_ANALYSIS_MAX_TOTAL_TASKS=12
FIN_ANALYSIS_DEADLINE_SECONDS=600
FIN_ANALYSIS_EXPECTED_VARIANT=
